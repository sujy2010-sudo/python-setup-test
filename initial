# 01_hello_world.py
"""
Learning Python variables and f-strings
Coming from Java, you'll love how simple this is!
"""

# 🔴 JAVA FLASHBACK:
# String name = "Alice";
# int age = 28;
# System.out.println("Name: " + name + ", Age: " + age);

# 🐍 PYTHON WAY:
name = "Alice"  # No type declaration needed!
age = 28        # No semicolons!

# Old way (like Java concatenation)
print("Name: " + name + ", Age: " + str(age))

# ✨ Modern Python way - f-strings (SO MUCH BETTER!)
print(f"Name: {name}, Age: {age}")

# You can do expressions inside f-strings!
print(f"Next year, {name} will be {age + 1}")

# Multi-line f-strings
message = f"""
Employee Profile:
  Name: {name}
  Age: {age}
  Status: Active
"""
print(message)

# Number formatting with f-strings
salary = 75000.50
print(f"Salary: ${salary:,.2f}")  # Output: $75,000.50

# Percentage formatting
bonus_rate = 0.15
print(f"Bonus Rate: {bonus_rate:.1%}")  # Output: 15.0%
